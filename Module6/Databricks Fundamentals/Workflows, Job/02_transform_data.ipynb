   "source": [
    "df = spark.table(\"sales.example.job_raw\")\n",
    "\n",
    "df_transformed = df.withColumn(\n",
    "    \"amount_with_tax\",\n",
    "    df.amount * 1.1\n",
    ")\n",
    "\n",
    "display(df_transformed)\n",
    "\n",
    "df_transformed.write \\\n",
    "    .format(\"delta\") \\\n",
    "    .mode(\"overwrite\") \\\n",
    "    .saveAsTable(\"sales.example.job_transformed\")"
   ]
  }
